{
  "name": "@nomos-ui/form",
  "version": "0.4.6",
  "description": "The Shadcn library for building robust React forms",
  "main": "dist/index.js",
  "module": "dist/exports/index.js",
  "types": "dist/exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js",
      "require": "./dist/exports/index.js"
    },
    "./utils": {
      "types": "./dist/exports/utils/index.d.ts",
      "import": "./dist/exports/utils/index.js",
      "require": "./dist/exports/utils/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "utils": ["./dist/exports/utils/index.d.ts"]
    }
  },
  "scripts": {
    "build": "trash dist && tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ui": "jest --ui",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "react",
    "react-hook-form",
    "form",
    "forms",
    "validation",
    "components",
    "ui",
    "input",
    "select",
    "checkbox",
    "accessible",
    "a11y",
    "tailwind",
    "typescript",
    "nomos"
  ],
  "author": "Uanela Como",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uanela/nomos-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/uanela/nomos-ui/issues"
  },
  "homepage": "https://github.com/uanela/nomos-ui",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@nomos-ui/common": "^0.3.1",
    "@nomos-ui/core": "^0.5.1",
    "@nomos-ui/layout": "^0.0.6",
    "@nomos-ui/uanela-redux-next": "^0.3.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/vite": "^4.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4.1.16",
    "trash-cli": "^7.0.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "react-hook-form": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
